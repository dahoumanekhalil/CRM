// Webscale — Training CRM
// Domain: leads, students, instructors, courses, sessions, registrations,
// attendance, payments, campaigns, communications, landing pages.
// See DESIGN.md §2 (Product vision) and §29 (Component architecture).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// Auth.js — employees who log into the CRM
// ==========================================================

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           UserRole  @default(EMPLOYEE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]

  ownedLeads             Lead[]           @relation("LeadOwner")
  assignedLeads          LeadAssignment[] @relation("LeadAssignmentTo")
  madeAssignments        LeadAssignment[] @relation("LeadAssignmentBy")
  salesRegistrations     Registration[]   @relation("RegistrationSalesOwner")
  recordedPayments       Payment[]        @relation("PaymentRecordedBy")
  recordedExpenses       Expense[]        @relation("ExpenseRecordedBy")
  nextActionLeads        Lead[]           @relation("LeadNextActionOwner")
  nextActionStudents     Student[]        @relation("StudentNextActionOwner")
  createdCourses    Course[]         @relation("CourseCreatedBy")
  instructor        Instructor?
  activities        Activity[]
  communications    Communication[]  @relation("CommunicationSentBy")
  attendance        Attendance[]     @relation("AttendanceRecordedBy")
  landingPages      LandingPage[]    @relation("LandingPageCreatedBy")
  forms             Form[]           @relation("FormCreatedBy")
  tasks             Task[]           @relation("TaskOwner")
  notifications     Notification[]
  telegramLinkTokens       TelegramLinkToken[]     @relation("TelegramLinkTokenEmployee")
  initiatedLinkTokens      TelegramLinkToken[]     @relation("TelegramLinkTokenInitiator")
  notificationPreferences  NotificationPreference[]
  scheduledNotifications   ScheduledNotification[]
  telegramConnection       TelegramConnection?     @relation("TelegramConnectionUser")
  initiatedConnections     TelegramConnection[]    @relation("TelegramConnectionInitiator")
  telegramAuditActions     TelegramConnectionAudit[] @relation("TelegramAuditActor")
  telegramAuditTargets     TelegramConnectionAudit[] @relation("TelegramAuditTarget")
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  MARKETING
  TRAINER
  FINANCE
  EMPLOYEE
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================================
// CRM — sales pipeline
// ==========================================================

model Lead {
  id         String     @id @default(cuid())
  firstName  String
  lastName   String?
  email      String?
  phone      String?
  preferredCallTime String?   // e.g. "Morning", "After 3 PM", free text from lead
  status     LeadStatus @default(NEW)
  source     String?
  notes      String?    @db.Text
  tags       String[]   @default([])

  ownerId      String?
  assignedById String?  // who last assigned this lead
  assignedAt   DateTime? // when the last assignment was made
  campaignId   String?
  courseId              String?  // course this lead is interested in (from landing page)
  interestedSessionId   String?  // session chosen by Sales during qualification (before conversion)
  studentId             String?  // set when the lead converts
  isHighPriority Boolean @default(false)

  // Retargeting / attribution — kept even after conversion so we can run
  // future campaigns against past leads.
  subscribed   Boolean @default(true)   // marketing consent from the form
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?

  // Next action — the single most important follow-up step for this lead.
  nextAction        String?
  nextActionDue     DateTime?
  nextActionOwnerId String?

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  lastContactedAt DateTime?
  viewedByOwnerAt DateTime? // cleared when ownership changes; set on first open by owner

  owner              User?           @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  nextActionOwner    User?           @relation("LeadNextActionOwner", fields: [nextActionOwnerId], references: [id], onDelete: SetNull)
  campaign           Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  course             Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  interestedSession  CourseSession?  @relation("LeadInterestedSession", fields: [interestedSessionId], references: [id], onDelete: SetNull)
  student            Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  communications     Communication[]
  assignments        LeadAssignment[]
  registrations      Registration[]  @relation("RegistrationSourceLead")

  @@index([status])
  @@index([ownerId])
  @@index([assignedById])
  @@index([campaignId])
  @@index([courseId])
  @@index([interestedSessionId])
  @@index([createdAt])   // dashboard KPIs + reports use 30-day windows on this field
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CONFIRMED
  REGISTERED
  LOST
  NOT_INTERESTED
  UNREACHABLE
}

// Immutable log of every lead ownership change.
// One row per assignment event — never updated, only appended.
model LeadAssignment {
  id           String   @id @default(cuid())
  leadId       String
  assignedToId String?  // null means unassigned (returned to inbox)
  assignedById String
  note         String?  @db.Text // optional reason / context
  createdAt    DateTime @default(now())

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("LeadAssignmentTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy User  @relation("LeadAssignmentBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([assignedToId])
  @@index([createdAt])
}

// ==========================================================
// People — students & instructors
// ==========================================================

model Student {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String?
  email       String?  @unique
  phone       String?
  dateOfBirth DateTime?
  address     String?
  notes       String?  @db.Text
  tags        String[] @default([])

  nextAction        String?
  nextActionDue     DateTime?
  nextActionOwnerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads             Lead[]
  registrations     Registration[]
  payments          Payment[]
  communications    Communication[]
  nextActionOwner   User?    @relation("StudentNextActionOwner", fields: [nextActionOwnerId], references: [id], onDelete: SetNull)

  @@index([nextActionOwnerId])
}

model Instructor {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?  @unique
  phone     String?
  bio       String?  @db.Text
  avatarUrl String?
  expertise String[] @default([])
  userId    String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  courses  Course[]        @relation("CoursePrimaryInstructor")
  sessions CourseSession[]
}

// ==========================================================
// Courses & sessions
// ==========================================================

model Course {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  description   String?      @db.Text
  summary       String?
  category      String?
  imageUrl      String?
  level         CourseLevel  @default(BEGINNER)
  durationHours Int?
  basePrice     Decimal?     @db.Decimal(12, 2)
  currency      String       @default("USD")
  status        CourseStatus @default(DRAFT)

  primaryInstructorId String?
  createdById         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryInstructor Instructor?   @relation("CoursePrimaryInstructor", fields: [primaryInstructorId], references: [id], onDelete: SetNull)
  createdBy         User?         @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sessions          CourseSession[]
  landingPages      LandingPage[]
  leads             Lead[]
  expenses          Expense[]

  @@index([status])
  @@index([category])
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

// A specific cohort/instance of a course (has real dates, capacity, location).
model CourseSession {
  id           String        @id @default(cuid())
  courseId     String
  instructorId String?
  title        String?
  startDate    DateTime
  endDate      DateTime
  location     String?
  city         String?
  country      String?
  capacity     Int           @default(20)
  price        Decimal?      @db.Decimal(12, 2)
  status       SessionStatus @default(UPCOMING)
  notes        String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor    Instructor?    @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  registrations Registration[]
  attendance    Attendance[]
  interestedLeads Lead[]       @relation("LeadInterestedSession")
  expenses      Expense[]

  @@index([courseId])
  @@index([status])
  @@index([startDate])
}

enum SessionStatus {
  DRAFT
  UPCOMING
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ==========================================================
// Registrations, attendance, payments
// ==========================================================

model Registration {
  id           String             @id @default(cuid())
  studentId    String
  sessionId    String
  leadId       String?            // set during lead conversion for attribution
  status       RegistrationStatus @default(PENDING)
  source       String?
  registeredAt DateTime           @default(now())
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  notes        String?            @db.Text
  // Sales tracking — who closed this registration and at what price.
  salesOwnerId String?
  agreedPrice  Decimal?           @db.Decimal(12, 2)

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session      CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation("RegistrationSourceLead", fields: [leadId], references: [id], onDelete: SetNull)
  salesOwner   User?         @relation("RegistrationSalesOwner", fields: [salesOwnerId], references: [id], onDelete: SetNull)
  payments     Payment[]
  attendance   Attendance[]

  @@unique([studentId, sessionId])
  @@index([status])
  @@index([sessionId])
  @@index([leadId])
  @@index([salesOwnerId])
  @@index([registeredAt])
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  ATTENDING
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Attendance {
  id             String           @id @default(cuid())
  registrationId String
  sessionId      String
  sessionDate    DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  checkInMethod  String           @default("manual")
  notes          String?
  recordedById   String?
  recordedAt     DateTime         @default(now())

  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  session      CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recordedBy   User?         @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([registrationId, sessionDate])
  @@index([sessionId, sessionDate])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Payment {
  id             String        @id @default(cuid())
  studentId      String
  registrationId String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("DZD")
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(PENDING)
  reference      String?
  notes          String?       @db.Text
  paidAt         DateTime?
  recordedById   String?       // who entered this payment into the system

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  recordedBy   User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)


  @@index([studentId])
  @@index([status])
  @@index([paidAt])
  @@index([recordedById])
  @@index([registrationId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  BANK_CHECK
  POSTAL_MOBILE  // BaridiMob and similar postal/mobile payment services
  CARD
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ==========================================================
// Finance — expenses
// ==========================================================

model Expense {
  id            String          @id @default(cuid())
  title         String
  description   String?         @db.Text
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("DZD")
  category      ExpenseCategory
  expenseDate   DateTime        @db.Date
  paymentMethod PaymentMethod
  courseId      String?
  sessionId     String?
  reference     String?
  notes         String?         @db.Text
  status        ExpenseStatus   @default(PENDING)
  recordedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course     Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  session    CourseSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  recordedBy User?         @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([expenseDate])
  @@index([sessionId])
  @@index([courseId])
  @@index([status])
}

enum ExpenseCategory {
  HALL_CLEANING
  FOOD_MEALS
  TRAINING_MATERIALS
  CLASSROOM_PREPARATION
  CONSUMABLES
  VENUE_COSTS
  TRANSPORTATION
  INSTRUCTOR_COSTS
  MARKETING
  UTILITIES
  OTHER
}

enum ExpenseStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ==========================================================
// Marketing — campaigns & communications
// ==========================================================

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?        @db.Text
  source      String?
  budget      Decimal?       @db.Decimal(12, 2)
  status      CampaignStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Communication {
  id        String                 @id @default(cuid())
  type      CommunicationType
  channel   String?
  direction CommunicationDirection @default(OUTBOUND)
  subject   String?
  body      String?                @db.Text

  leadId    String?
  studentId String?
  sentById  String?
  sentAt    DateTime?

  createdAt DateTime @default(now())

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  sentBy  User?    @relation("CommunicationSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([studentId])
  @@index([createdAt])
}

enum CommunicationType {
  CALL
  EMAIL
  SMS
  WHATSAPP
  MEETING
  NOTE
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

// ==========================================================
// Activity feed — user actions across the system
// ==========================================================

model Activity {
  id       String   @id @default(cuid())
  type     String   // e.g. "lead.created", "course.published"
  entity   String   // "Lead" | "Course" | ...
  entityId String
  userId   String?
  meta     Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ==========================================================
// Landing pages — data-driven blocks
// See DESIGN.md §12–15 (Builder), §29 (LandingBlock type)
// ==========================================================

model LandingPage {
  id             String            @id @default(cuid())
  courseId       String?
  slug           String            @unique
  title          String
  status         LandingPageStatus @default(DRAFT)
  blocks         Json              @default("[]")
  theme          Json              @default("{}")
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  publishedAt    DateTime?

  templateId  String?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  template  LandingPageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy User?                @relation("LandingPageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([courseId])
}

enum LandingPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LandingPageTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?
  category        String?
  previewImageUrl String?
  blocks          Json     @default("[]")
  theme           Json     @default("{}")
  isBuiltin       Boolean  @default(false)

  createdAt DateTime @default(now())

  pages LandingPage[]
}

// ==========================================================
// Forms — reusable form builder for landing pages & external sites
// ==========================================================

model Form {
  id          String   @id @default(cuid())
  name        String
  description String?
  fields      Json     @default("[]")  // FormField[]
  settings    Json     @default("{}")  // FormSettings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  createdBy   User?          @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  submissions FormSubmission[]

  @@index([createdAt])
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  data      Json                  // { fieldId: value, ... }
  metadata  Json?                 // { ip, userAgent, origin, utmSource, ... }
  createdAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
}

// ==========================================================
// Tasks — cross-cutting accountability & follow-up engine
// See LEVEL2.md §A1 (Task Engine)
// ==========================================================

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  ownerId     String?
  priority    TaskPriority @default(NORMAL)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?
  entityType  String?      // "Lead" | "Student" | "Course" | "Session" | "Payment" | "Campaign" | "LandingPage"
  entityId    String?
  source      String       @default("manual") // "manual" | "system"
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  completedAt DateTime?

  owner User? @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
  @@index([entityType, entityId])
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Singleton row (id = "default") for org-wide configuration.
model OrgSettings {
  id          String   @id @default("default")
  name        String   @default("My Organization")
  currency    String   @default("USD")
  timezone    String   @default("UTC")
  updatedAt   DateTime @updatedAt
}

// ==========================================================
// Notifications — in-app persistent notification center
// ==========================================================

enum NotificationCategory {
  ACTION_REQUIRED
  INFO
  SUCCESS
  SYSTEM
}

model Notification {
  id          String               @id @default(cuid())
  recipientId String
  type        String
  category    NotificationCategory @default(INFO)
  title       String
  body        String?
  entityType  String?
  entityId    String?
  read        Boolean              @default(false)
  readAt      DateTime?
  priority    Int                  @default(0)
  createdAt   DateTime             @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
  @@index([type, entityId, recipientId])
}

// ==========================================================
// Telegram — one-time account linking tokens
// See LEVEL2.md §C3 (Employee Telegram Connection Flow)
// ==========================================================

model TelegramLinkToken {
  id               String    @id @default(cuid())
  employeeId       String
  token            String    @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())
  initiatedById    String?
  connectionMethod String    @default("SELF") // "SELF" | "ADMIN" | "MANAGER"

  employee    User  @relation("TelegramLinkTokenEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  initiatedBy User? @relation("TelegramLinkTokenInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
}

// ==========================================================
// Notification preferences — per-employee, per-type, per-channel
// See LEVEL2.md §C4 (Notification Preferences)
// ==========================================================

model NotificationPreference {
  id         String  @id @default(cuid())
  employeeId String
  type       String  // NotificationType string value
  channel    String  // "telegram" | "inapp"
  enabled    Boolean @default(true)

  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, type, channel])
  @@index([employeeId, channel])
}

// ==========================================================
// Scheduled notifications — reliable async delivery queue
// See LEVEL2.md §C6 (Notification Scheduling Engine)
// ==========================================================

enum ScheduledNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model ScheduledNotification {
  id            String                      @id @default(cuid())
  type          String
  recipientId   String
  payload       Json
  scheduledAt   DateTime
  status        ScheduledNotificationStatus @default(PENDING)
  attemptCount  Int                         @default(0)
  lastAttemptAt DateTime?
  failureReason String?                     @db.Text
  sentAt        DateTime?
  provider      String                      @default("all") // "all" | "telegram" | "inapp"
  entityType    String?
  entityId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])   // processQueue — PENDING + due-time filter
  @@index([status, sentAt])        // delivery stats latency queries
  @@index([recipientId])
  @@index([entityType, entityId])
}

// ==========================================================
// Telegram — connection state machine & audit trail
// See LEVEL2.md §C — Phase 1 (TelegramConnection model)
// ==========================================================

enum TelegramConnectionStatus {
  PENDING
  CONNECTED
  DISABLED
  REVOKED
  BLOCKED
  ERROR
}

enum TelegramConnectionMethod {
  SELF
  ADMIN
  MANAGER
}

model TelegramConnection {
  id               String                   @id @default(cuid())
  userId           String                   @unique
  telegramUserId   String?
  telegramChatId   String?
  username         String?
  firstName        String?
  lastName         String?
  status           TelegramConnectionStatus @default(PENDING)
  connectionMethod TelegramConnectionMethod @default(SELF)
  connectedById    String?
  connectedAt      DateTime?
  lastVerifiedAt   DateTime?
  disconnectedAt   DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  user        User  @relation("TelegramConnectionUser", fields: [userId], references: [id], onDelete: Cascade)
  connectedBy User? @relation("TelegramConnectionInitiator", fields: [connectedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([telegramChatId])
}

model TelegramConnectionAudit {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String
  action       String   // "connected" | "disconnected" | "revoked" | "admin_initiated" | "re_linked"
  method       String?
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor      User @relation("TelegramAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUser User @relation("TelegramAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@index([actorId])
  @@index([createdAt])
}

model TelegramBroadcast {
  id             String   @id @default(cuid())
  message        String   @db.Text
  sentById       String
  targetType     String   // "all" | "roles" | "users"
  targetRoles    String[] // UserRole values when targetType = "roles"
  targetUserIds  String[] // User IDs when targetType = "users"
  recipientCount Int      @default(0)
  sentCount      Int      @default(0)
  failedCount    Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([sentById])
  @@index([createdAt])
}

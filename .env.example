# Database
DATABASE_URL="postgresql://webscale:webscale_dev_password@localhost:5433/webscale?schema=public"

# Telegram Bot (from @BotFather — never expose TELEGRAM_BOT_TOKEN client-side)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Random 32+ char secret for webhook signature validation
TELEGRAM_WEBHOOK_SECRET=""

# Cron job authorization (set same value in Vercel Cron or external scheduler)
CRON_SECRET=""

# Base URL used to build deep links sent in Telegram messages
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# OAuth providers
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# LiveKit — self-hosted video conferencing
# Dev defaults match `livekit-server --dev` and the compose.yml livekit service
# NEVER expose LIVEKIT_API_SECRET to the client (no NEXT_PUBLIC_ prefix)
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
